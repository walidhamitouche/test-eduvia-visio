# Modèle documentaire : NE CONTIENT AUCUN SECRET. Les vrais fichiers (.env.development,
# .env.test, .env.production) sont créés et chiffrés par `uv run task env-init <env>`.
APP_ENV=development
API_KEY=
LINK_SIGNING_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
WEBHOOK_URL=
WEBHOOK_SECRET=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-west-3
BRAND_NAME=Eduvia Visio
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR="#E8505B"
BRAND_SECONDARY_COLOR="#1F1F1F"
DATABASE_URL=sqlite:///./data/visio.db
# Facultatif : protection des routes publiques (0 = désactivé)
# JOIN_RATE_LIMIT_PER_MINUTE=1500
# MAX_PARTICIPANTS_PER_MEETING=40
# Facultatif : dossier de l'interface construite (défaut web/dist)
# WEB_DIST_DIR=web/dist
# Enregistrement en segments fusionnes a la fin (0 = un seul MP4). Conseille : 600. Requiert ffmpeg.
# RECORDING_SEGMENT_SECONDS=600
# Mise en page « réunion » de l'enregistrement : OBLIGATOIRE (URL vue depuis le conteneur Egress)
RECORDING_TEMPLATE_URL=http://host.docker.internal:8000/recording-template
